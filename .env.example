# Nova Chrono Web App — Environment Variables
# Copy this file to .env and fill in your values

# MongoDB connection (same as the bot's MONGODB_URI)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0
MONGODB_DB=nova_chrono_bot

# Web server port (default 3002)
PORT=3002

# Secret key for signing session tokens (use a long random string)
SESSION_SECRET=331cfab91b92030a57cf3632b47e1e5aee2ed1f984bf124985062491727c95aa

# CORS allowed origin (* for development, your domain in production)
ALLOWED_ORIGIN=*

# Your bot's Telegram username (for deep links shown in the UI)
BOT_USERNAME=YOUR_BOT_USERNAME
